#include <bits/stdc++.h>
#define endl '\n'
#define ll long long
using namespace std;

bool isBalanced(ll n){
    ll numOf0 = 0;
    ll numOf1 = 0;
    while(n){
        if(n & 1) numOf1++;
        else numOf0++;
        n >>= 1;
    }
    return numOf0 == numOf1;
}

int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    ll n,cnt = 0;
    cin >> n;
    for(ll i = 0 ; i < n ; ++i){
        ll num;
        cin >> num;
        if(isBalanced(num)) ++cnt;
    }
    cout << cnt << endl;
    return 0;
}
